# Copy to backend/.env and fill in only what you have. Never commit .env; never paste keys into
# chat, issues or frontend code. Check what actually works with: python scripts/check_providers.py
# Yahoo Finance (price history) needs no key.

# ── Provider keys (all optional; every one missing just reduces capability) ──────────────
# Finnhub (quotes, profiles, company news, earnings, analyst trends) — free key at finnhub.io
# (free plan: 60 calls/minute). Use a NEW key: the one once committed to this repo is public.
FINNHUB_API_KEY=
# FRED (economic series) — free key at fredaccount.stlouisfed.org/apikeys.
# Without one, FRED's public CSV download is used instead.
FRED_API_KEY=
# NewsAPI.org (headlines) — free key at newsapi.org. The free Developer plan is 24 h delayed,
# 100 requests/day, and for development only: it is switched off automatically when
# MARKETVISION_ENV is staging or production.
NEWSAPI_KEY=
# Set to 1 ONLY if NEWSAPI_KEY belongs to a paid NewsAPI plan that permits production use.
MARKETVISION_NEWSAPI_PAID_PLAN=0

# ── Language-model explanations (optional; the app works fully without them) ─────────────
# Any OpenAI-compatible chat server. Needs the openai package: pip install -r requirements-heavy.txt
# Free, local:  MARKETVISION_LLM_BASE_URL=http://127.0.0.1:8089/v1   MARKETVISION_LLM_MODEL=<name the server serves>
# Paid, hosted (OpenAI): leave the URL empty, set MARKETVISION_LLM_API_KEY and the model.
# Paid, hosted (Claude, via its OpenAI-compatible beta endpoint — see docs/API_INTEGRATIONS.md):
#               MARKETVISION_LLM_BASE_URL=https://api.anthropic.com/v1/   MARKETVISION_LLM_MODEL=<a Claude model id>
MARKETVISION_LLM_API_KEY=
MARKETVISION_LLM_BASE_URL=
MARKETVISION_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY is also honoured for the key.

# ── Access control ───────────────────────────────────────────────────────────────────────
# read scope: research routes. admin scope: paper orders, pause/reset, resolve, copilot.
# Unset on a development machine = open. In production the admin routes refuse to run unset.
MARKETVISION_TOOL_TOKEN=
MARKETVISION_ADMIN_TOKEN=
# Browser origins allowed to call the API (comma-separated). Defaults to localhost dev servers.
MARKETVISION_CORS_ORIGINS=

# ── Behaviour ────────────────────────────────────────────────────────────────────────────
MARKETVISION_ENV=development
# 1 = never contact any provider (tests, air-gapped machines); snapshots still work
MARKETVISION_OFFLINE=0
# FinBERT sentiment needs requirements-heavy.txt (torch + transformers)
MARKETVISION_ENABLE_FINBERT=0
MARKETVISION_PAPER_TRADING=1
MARKETVISION_HTTP_TIMEOUT=10
MARKETVISION_HTTP_RETRIES=2
# Where ledgers, caches, snapshots and the paper database live (default backend/data)
MARKETVISION_DATA_DIR=
# Where model runs and the registry live (default backend/models)
MARKETVISION_MODEL_DIR=
# Serve price history from a named data snapshot as a fallback provider
MARKETVISION_SNAPSHOT_ID=
